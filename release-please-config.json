{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "skip-changelog": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this pull request tags the release and starts the release workflow: PyPI, container images, GitHub Release, and documentation. Before merging, rename the `## [Unreleased]` heading of CHANGELOG.md to this version in a separate pull request; the GitHub Release takes its notes from that section and falls back to the list below.",
  "changelog-sections": [
    { "type": "feat", "section": "Added" },
    { "type": "fix", "section": "Fixed" },
    { "type": "perf", "section": "Changed" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "revert", "section": "Reverted" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Changed", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "Continuous integration", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "dvf-framework"
    }
  }
}
