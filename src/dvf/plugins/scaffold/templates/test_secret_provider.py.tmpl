"""Tests of the ``{{name}}`` secret provider.

Run ``pytest`` after ``pip install -e ".[test]"``.
"""

from __future__ import annotations

from pathlib import Path

import pytest
from dvf import api
from dvf.plugins import PluginKind, SecretContext, SecretRef, new_registry

from {{module}}.{{kind_module}} import {{class_name}}

NAME = "{{name}}"
FOLDER_VARIABLE = "{{env_var}}"


def test_registered_through_its_entry_point() -> None:
    registry = new_registry(load_entry_points=True)
    assert registry.get(PluginKind.SECRET_PROVIDER, NAME).implementation is {{class_name}}
    assert not registry.load_failures


def _provider(folder: Path) -> {{class_name}}:
    context = SecretContext(environ={FOLDER_VARIABLE: str(folder)}, base_dir=folder)
    return {{class_name}}(context)


def test_reads_files_and_json_keys(tmp_path: Path) -> None:
    (tmp_path / "db_password").write_text("s3cret\n", encoding="utf-8")
    (tmp_path / "api.json").write_text('{"token": "abc"}', encoding="utf-8")
    provider = _provider(tmp_path)
    assert provider.resolve(SecretRef.parse(f"{NAME}:db_password")) == "s3cret"
    assert provider.resolve(SecretRef.parse(f"{NAME}:api.json#token")) == "abc"


@pytest.mark.parametrize(
    ("reference", "error"),
    [
        ("missing", LookupError),
        ("../outside", ValueError),
        ("db_password#key", ValueError),
        ("api.json#other", LookupError),
    ],
)
def test_errors_name_the_problem(tmp_path: Path, reference: str, error: type[Exception]) -> None:
    (tmp_path / "db_password").write_text("s3cret", encoding="utf-8")
    (tmp_path / "api.json").write_text('{"token": "abc"}', encoding="utf-8")
    with pytest.raises(error) as caught:
        _provider(tmp_path).resolve(SecretRef.parse(f"{NAME}:{reference}"))
    assert "s3cret" not in str(caught.value) and "abc" not in str(caught.value)


def test_resolves_references_in_a_configuration(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.setenv(FOLDER_VARIABLE, str(tmp_path))
    (tmp_path / "warehouse").write_text("analytics.duckdb", encoding="utf-8")
    config = {
        "version": 1,
        "project": {"name": "plugin-test"},
        "connections": {"wh": {"type": "duckdb", "database": f"${{secret:{NAME}:warehouse}}"}},
    }
    loaded = api.load_config_data(config, base_dir=tmp_path)
    assert loaded.config.connections["wh"].database == "analytics.duckdb"  # type: ignore[attr-defined]
