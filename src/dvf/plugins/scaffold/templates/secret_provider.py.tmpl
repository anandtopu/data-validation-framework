"""The ``{{name}}`` secret provider.

{{summary}}
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import ClassVar

from dvf.plugins import SecretProvider, SecretRef


class {{class_name}}(SecretProvider):
    """Secrets stored as files in a folder, such as Docker and Kubernetes secret mounts.

    ``${secret:{{name}}:<file>}`` is the text of ``<file>`` in the folder named by the
    ``{{env_var}}`` environment variable (or the project's ``.env`` file), by default
    ``/run/secrets``; ``${secret:{{name}}:<file>#<key>}`` selects one key of a JSON file.
    dvf registers every resolved value for redaction, so it never appears in logs or reports.
    Error messages must never contain a secret value.
    """

    plugin_name: ClassVar[str] = "{{name}}"
    dvf_plugin_api: ClassVar[str | None] = "{{plugin_api}}"
    folder_variable: ClassVar[str] = "{{env_var}}"
    default_folder: ClassVar[str] = "/run/secrets"

    def _folder(self) -> Path:
        folder = Path(self.context.env(self.folder_variable) or self.default_folder)
        return folder if folder.is_absolute() else self.context.base_dir / folder

    def resolve(self, ref: SecretRef) -> str:
        """Return the secret's value. Exceptions become dvf secret errors."""
        folder = self._folder().resolve()
        file = (folder / ref.path).resolve()
        if folder not in file.parents:
            raise ValueError(f"Secret '{ref.path}' is outside the secrets folder.")
        if not file.is_file():
            raise LookupError(
                f"No secret file '{ref.path}' in {folder}; set {self.folder_variable} to the "
                "folder holding the secret files."
            )
        text = file.read_text(encoding="utf-8").rstrip("\r\n")
        if ref.key is None:
            return text
        try:
            document = json.loads(text)
        except ValueError:
            document = None
        if not isinstance(document, dict):
            raise ValueError(f"Secret '{ref.path}' is not a JSON object; remove '#{ref.key}'.")
        if ref.key not in document:
            raise LookupError(f"Secret '{ref.path}' has no key '{ref.key}'.")
        return str(document[ref.key])
