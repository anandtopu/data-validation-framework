{#-
  dvf HTML report. Self-contained: no external scripts, stylesheets, fonts, or images.
  Each section lives in its own template; put a file with the same name in
  ReportOptions.templates_dir to override it.
-#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ generator }}">
<title>{{ title }} · {{ run.status }} · {{ run.run_id }}</title>
<style>
{% include "_styles.css.j2" %}
</style>
</head>
<body>
{% include "_header.html.j2" %}
<main>
{% include "_summary.html.j2" %}
{% include "_tables.html.j2" %}
{% include "_checks.html.j2" %}
{% include "_extra.html.j2" %}
{% include "_environment.html.j2" %}
</main>
<footer>Generated by {{ generator }} from results schema {{ run.schema_version }}. This file works offline.</footer>
<script>
{% include "_script.js.j2" %}
</script>
</body>
</html>
