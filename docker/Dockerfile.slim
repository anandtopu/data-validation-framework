# syntax=docker/dockerfile:1
#
# dvf, slim image: the core package only. DuckDB, SQLite, and CSV, TSV, Parquet, JSON, and
# NDJSON files work out of the box; no database drivers are installed.
#
# Build from the repository root (the build context must be the root, not docker/):
#
#   docker build -f docker/Dockerfile.slim --build-arg DVF_VERSION=1.0.0 -t dvf:slim .
#
# Dependencies are installed from uv.lock with `uv sync --locked`, so an image built from a
# given commit has the same package versions as the lockfile at that commit. The base images
# are pinned by digest in the FROM lines, where Dependabot's docker updates can refresh them.

FROM ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc AS uv

# ---------------------------------------------------------------- build stage
FROM docker.io/library/python:3.13-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS builder

COPY --from=uv /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=/usr/local/bin/python3 \
    UV_PROJECT_ENVIRONMENT=/opt/dvf

WORKDIR /src

# Third-party dependencies first, so a source change reuses this layer.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-install-project --no-editable

# Then dvf itself, as a regular (non-editable) install. hatch-vcs reads the version from git,
# and .git is not in the build context, so the version is passed in.
ARG DVF_VERSION=0.0.0+container
COPY README.md LICENSE NOTICE ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    SETUPTOOLS_SCM_PRETEND_VERSION="${DVF_VERSION}" \
    uv sync --locked --no-dev --no-editable --reinstall-package dvf-framework \
 && /opt/dvf/bin/dvf --version \
 && rm -rf /opt/dvf/lib/python3*/site-packages/pyarrow/tests \
           /opt/dvf/lib/python3*/site-packages/pyarrow/include

# ---------------------------------------------------------------- runtime stage
FROM docker.io/library/python:3.13-slim-trixie@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS runtime

ARG DVF_VERSION=0.0.0+container
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG SOURCE_URL=

LABEL org.opencontainers.image.title="dvf-slim" \
      org.opencontainers.image.description="dvf data and schema validation, slim image: DuckDB, SQLite, and files" \
      org.opencontainers.image.version="${DVF_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/python:3.13-slim-trixie"

# A fixed non-root user. Group 0 owns the writable folders, so the image also runs under an
# arbitrary UID (docker run --user, OpenShift).
RUN useradd --uid 10001 --gid 0 --no-log-init --create-home --home-dir /home/dvf \
        --shell /usr/sbin/nologin dvf \
 && mkdir /work \
 && chown 10001:0 /work \
 && chmod 0775 /work /home/dvf

COPY --from=builder /opt/dvf /opt/dvf

ENV PATH=/opt/dvf/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER 10001:0
WORKDIR /work

# dvf turns SIGINT into an orderly stop: finished tables are checkpointed, partial results are
# written, and the exit code is 2. `docker stop` sends it.
STOPSIGNAL SIGINT

ENTRYPOINT ["dvf"]
CMD ["--help"]
