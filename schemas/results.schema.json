{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dvf results",
  "x-dvf-results-schema-version": "1.0.0",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "A file produced alongside the report, such as a mismatch extract or repro SQL.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CanonicalType": {
      "additionalProperties": false,
      "description": "An engine-independent column type.\n\nAttributes that do not apply to a logical type stay ``None`` (or their default).\n``length=None`` on strings and binaries means unbounded; ``precision=None`` on decimals means\nthe engine's maximum or a floating decimal.",
      "properties": {
        "logical": {
          "$ref": "#/$defs/LogicalType"
        },
        "bits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bits"
        },
        "unsigned": {
          "default": false,
          "title": "Unsigned",
          "type": "boolean"
        },
        "precision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "scale": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "fixed_length": {
          "default": false,
          "title": "Fixed Length",
          "type": "boolean"
        },
        "unicode": {
          "default": true,
          "title": "Unicode",
          "type": "boolean"
        },
        "element": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "key": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fields": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructField"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "logical"
      ],
      "title": "CanonicalType",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "description": "The outcome of one check, comparison, or schema validation.",
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "dimension": {
          "$ref": "#/$defs/Dimension"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "side": {
          "anyOf": [
            {
              "$ref": "#/$defs/Side"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "observed": {
          "default": null,
          "title": "Observed"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "unexpected_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unexpected Count"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Count"
        },
        "unexpected_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unexpected Pct"
        },
        "mostly": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mostly"
        },
        "samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "column_mismatches": {
          "items": {
            "$ref": "#/$defs/ColumnMismatch"
          },
          "title": "Column Mismatches",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricComparison"
          },
          "title": "Metrics",
          "type": "array"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "title": "Hints",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/QueryRecord"
          },
          "title": "Queries",
          "type": "array"
        },
        "normalization": {
          "items": {
            "type": "string"
          },
          "title": "Normalization",
          "type": "array"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "partition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partition"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimingBreakdown"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "waiver": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaiverApplied"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "details": {
          "additionalProperties": true,
          "description": "Custom details from configuration or plugins.",
          "title": "Details",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "check_id",
        "name",
        "type",
        "dimension",
        "severity",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ColumnMismatch": {
      "additionalProperties": false,
      "description": "Per-column mismatch summary for a source-vs-target comparison.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        },
        "mismatch_count": {
          "title": "Mismatch Count",
          "type": "integer"
        },
        "mismatch_pct": {
          "title": "Mismatch Pct",
          "type": "number"
        },
        "classifications": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Mismatch class (for example 'whitespace_only') to number of rows.",
          "title": "Classifications",
          "type": "object"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "title": "Hints",
          "type": "array"
        },
        "samples": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleSet"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "column",
        "mismatch_count",
        "mismatch_pct"
      ],
      "title": "ColumnMismatch",
      "type": "object"
    },
    "ColumnProfile": {
      "additionalProperties": false,
      "description": "Summary statistics of one column on one side.",
      "properties": {
        "count": {
          "title": "Count",
          "type": "integer"
        },
        "null_count": {
          "title": "Null Count",
          "type": "integer"
        },
        "null_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Pct"
        },
        "distinct_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distinct Count"
        },
        "min": {
          "default": null,
          "title": "Min"
        },
        "max": {
          "default": null,
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "min_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Length"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "avg_length": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Length"
        }
      },
      "required": [
        "count",
        "null_count"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "ColumnSchemaDiff": {
      "additionalProperties": false,
      "description": "One row of a schema comparison.",
      "properties": {
        "source_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Column"
        },
        "target_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Column"
        },
        "status": {
          "description": "'matched', 'missing_in_target', or 'extra_in_target'.",
          "title": "Status",
          "type": "string"
        },
        "source_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_native_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Native Type"
        },
        "target_native_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Native Type"
        },
        "compatibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compatibility"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "nullable_change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nullable Change"
        }
      },
      "required": [
        "source_column",
        "target_column",
        "status"
      ],
      "title": "ColumnSchemaDiff",
      "type": "object"
    },
    "Compatibility": {
      "description": "How safely values of one type fit into another.",
      "enum": [
        "exact",
        "compatible_widening",
        "lossy",
        "unknown",
        "incompatible"
      ],
      "title": "Compatibility",
      "type": "string"
    },
    "DatasetKind": {
      "enum": [
        "table",
        "query",
        "path",
        "dataframe"
      ],
      "title": "DatasetKind",
      "type": "string"
    },
    "DatasetPairResult": {
      "additionalProperties": false,
      "description": "Results for one table (or dataset pair) in a suite.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "row_counts": {
          "$ref": "#/$defs/RowCounts"
        },
        "reconciliation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReconciliationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_diff": {
          "items": {
            "$ref": "#/$defs/ColumnSchemaDiff"
          },
          "title": "Schema Diff",
          "type": "array"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProfileComparison"
          },
          "title": "Profiles",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "title": "Checks",
          "type": "array"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "DatasetPairResult",
      "type": "object"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "description": "Where a dataset lives: a table, a query, a file path, or an in-process DataFrame.",
      "properties": {
        "connection": {
          "title": "Connection",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DatasetKind"
        },
        "name": {
          "description": "Qualified table name, file path, query label, or DataFrame name.",
          "title": "Name",
          "type": "string"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query"
        }
      },
      "required": [
        "connection",
        "kind",
        "name"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Dimension": {
      "description": "Data quality dimension a check belongs to.",
      "enum": [
        "completeness",
        "uniqueness",
        "validity",
        "consistency",
        "referential_integrity",
        "accuracy",
        "timeliness",
        "volume",
        "distribution",
        "schema",
        "reconciliation",
        "custom"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "description": "An execution error, with a remediation hint when one is known.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "traceback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceback"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "LogicalType": {
      "description": "The logical kind of a value, independent of any engine.",
      "enum": [
        "BOOLEAN",
        "INTEGER",
        "DECIMAL",
        "FLOAT",
        "STRING",
        "BINARY",
        "DATE",
        "TIME",
        "TIMESTAMP",
        "TIMESTAMP_TZ",
        "INTERVAL",
        "UUID",
        "JSON",
        "ARRAY",
        "MAP",
        "STRUCT",
        "SPATIAL",
        "UNKNOWN"
      ],
      "title": "LogicalType",
      "type": "string"
    },
    "MetricComparison": {
      "additionalProperties": false,
      "description": "One metric compared between source and target: a row count or a control total.\n\nGrouped comparisons produce one entry per group, with ``group`` holding the group's values.",
      "properties": {
        "metric": {
          "description": "For example 'row_count', 'sum', 'min', or 'null_count'.",
          "title": "Metric",
          "type": "string"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target column name, if any.",
          "title": "Column"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        },
        "group": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group"
        },
        "source": {
          "default": null,
          "title": "Source"
        },
        "target": {
          "default": null,
          "title": "Target"
        },
        "difference": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target minus source, for numeric metrics.",
          "title": "Difference"
        },
        "tolerance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "metric",
        "passed"
      ],
      "title": "MetricComparison",
      "type": "object"
    },
    "ProfileComparison": {
      "additionalProperties": false,
      "description": "Source and target profiles of a column, side by side.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "source_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "differences": {
          "description": "Human-readable differences between the profiles.",
          "items": {
            "type": "string"
          },
          "title": "Differences",
          "type": "array"
        }
      },
      "required": [
        "column"
      ],
